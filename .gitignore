node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
data/events.jsonl
data/events.backup-*.jsonl

# 비밀값 — 정확한 파일명만 막으면 .env.production 같은 게 샌다
.env*
!.env.example

# 배포 도구
.vercel/

# 매장에서 찍은 사진·영상. 사람이 찍히고 용량이 크다
public/media/*
!public/media/촬영목록.md

# 프로젝트 폴더 안에 만들어 둔 zip 백업.
# 추적도 무시도 안 된 채 있어서 `git add -A` 한 번이면 스테이징된다.
# 그중 하나가 147MB라 GitHub 100MB 제한에 걸려 push가 통째로 실패한다.
*.zip

# Claude Code 로컬 설정 — 이 기기에서만 쓰는 권한 규칙. 공유하지 않는다
.claude/settings.local.json

# 미리보기용 임시 폴더 (작업 중에만 씀)
.tmp-preview/

# 스키마 숫자 — npm run check 가 매번 다시 만든다
db/.counts.json

# 발표 자료·개인 준비 노트·사업화 지원 서류는 저장소에 두지 않는다.
# 제출물도 코드도 아니면 파일로 전달한다 (2026-09-11, 사장님).
# 2026-09-11 에 다른 브랜치에서 다섯 개가 실제로 들어왔다.
docs/사업화지원_*.md
docs/발표*.md

# 이 폴더에서 만들어지는 로컬 산출물 — 저장소에 둘 것이 아니다 (2026-09-12).
# 1) 제출용 HTML 을 복사해 둔 폴더. 정본은 docs/제출물/ 이고 이건 사본이라
#    같이 두면 어느 쪽이 최신인지 알 수 없게 된다
storenote_docs/
# 2) 앱의 「내보내기」가 만든 백업. roster·punches·contracts·sales·vendors 가
#    통째로 들어 있다 — 실명·시급·매출·거래처 단가다. 절대 올리지 않는다
매장수첩_백업_*.json
# 3) 지표·환경파일 백업 폴더 (events jsonl + .env.local 사본)
_매장수첩-지표백업/
# 4) 문서를 종이로 뽑은 것. 정본은 docs/제출물/ 의 HTML 이다
/*.pdf

# Replit 이 작업공간에 스스로 만드는 폴더 (2026-09-14). 저장소 것이 아니다.
# ★ Tailwind v4 가 .gitignore 를 존중하므로 여기 적어야 클래스 스캔에서도 빠진다.
.local/
.agents/
.migration-backup/
.cache/
.config/
