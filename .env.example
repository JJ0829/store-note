# 매장수첩 환경변수
#
# ★ 이 파일은 예시다. 실제 값은 .env.local (git 제외) 이나
#   배포처(Vercel)의 Settings → Environment Variables 에 넣는다.

# 배포 주소. 카카오톡으로 링크를 보냈을 때 미리보기가 뜨게 한다.
# ★ 빌드 시점에 박힌다 — 값을 바꾸면 다시 배포해야 한다.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# 촬영 목록 만들기(AI) 에 쓴다. 없으면 그 기능만 "키가 없습니다" 로 뜨고
# 나머지 화면은 그대로 돈다.
#
# ★ NEXT_PUBLIC_ 을 붙이면 안 된다 — 브라우저 번들에 키가 박힌다.
#   서버 라우트(/api/shoot-plan)에서만 읽는다.
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ★ 매장 번호 — 레시피를 **서버가 실제로 막는다.**
#
#   이걸 넣으면 서버가 쿠키를 확인하고, 없으면 레시피를 아예 안 그린다.
#   보낼 것이 없으니 페이지 소스를 열어도 없다.
#
#   ⚠️ 안 넣으면 **안 막는다.** 화면이 빨간 띠로 크게 알리지만, 링크를
#     아는 사람은 레시피를 볼 수 있다 (사장님 결정 2026-09-10 —
#     환경변수를 깜빡해서 시연 중 레시피가 안 열리는 쪽이 더 큰 사고다).
#
#   ⚠️ **6자리 이상**으로 잡을 것. 4자리는 후보가 10,000개뿐이라
#     시도 제한이 있어도 결국 뚫린다. 시도 제한도 서버 메모리에 세므로
#     서버가 여러 개면 각자 따로 센다 — 느리게 할 뿐 못 막는다.
#
#   ⚠️ NEXT_PUBLIC_ 을 붙이면 안 된다. 붙이면 브라우저 번들에 박혀서
#     잠금이 완전히 무의미해진다.
#
#   바꾸면 직원들이 쓰던 쿠키가 무효가 되어 다시 넣어야 한다.
STORE_PIN=135790
