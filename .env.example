# 매장수첩 환경변수
#
# ★ 이 파일은 예시다. 실제 값은 .env.local (git 제외) 이나
#   배포처(Vercel)의 Settings → Environment Variables 에 넣는다.

# 배포 주소. 카카오톡으로 링크를 보냈을 때 미리보기가 뜨게 한다.
# ★ 빌드 시점에 박힌다 — 값을 바꾸면 다시 배포해야 한다.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# 촬영 목록 만들기(AI) 에 쓴다. 없으면 그 기능만 "키가 없습니다" 로 뜨고
# 나머지 화면은 그대로 돈다.
#
# ★ NEXT_PUBLIC_ 을 붙이면 안 된다 — 브라우저 번들에 키가 박힌다.
#   서버 라우트(/api/shoot-plan)에서만 읽는다.
# 발급: https://aistudio.google.com/apikey  (무료 등급이 있다)
GEMINI_API_KEY=AIzaSy...

# ★ 매장 번호 — 레시피를 **서버가 실제로 막는다.**
#
#   이걸 넣으면 서버가 쿠키를 확인하고, 없으면 레시피를 아예 안 그린다.
#   보낼 것이 없으니 페이지 소스를 열어도 없다.
#
#   ⚠️ 안 넣으면 **안 막는다.** 화면이 빨간 띠로 크게 알리지만, 링크를
#     아는 사람은 레시피를 볼 수 있다 (사장님 결정 2026-09-10 —
#     환경변수를 깜빡해서 시연 중 레시피가 안 열리는 쪽이 더 큰 사고다).
#
#   ⚠️ **6자리 이상**으로 잡을 것. 4자리는 후보가 10,000개뿐이라
#     시도 제한이 있어도 결국 뚫린다. 시도 제한도 서버 메모리에 세므로
#     서버가 여러 개면 각자 따로 센다 — 느리게 할 뿐 못 막는다.
#
#   ⚠️ NEXT_PUBLIC_ 을 붙이면 안 된다. 붙이면 브라우저 번들에 박혀서
#     잠금이 완전히 무의미해진다.
#
#   바꾸면 직원들이 쓰던 쿠키가 무효가 되어 다시 넣어야 한다.
#
#   ★ 아래 칸은 **비워둔다.** 예시 숫자를 적어두면 그걸 그대로 쓰게 되고,
#     그 값은 이 파일과 테스트에 적혀 있어 사실상 공개된 번호다.
STORE_PIN=

# ★ 서버 DB + 촬영 보관함 + 로그인 — 이 둘이 세 가지를 연다.
#
#   2026-09-13 부터 이 두 칸이 세 가지를 연다:
#     · 이용 기록(지표)  → `events` 표
#     · 촬영 사진·영상   → `media` 버킷 (비공개 · 서명 주소로만 열린다)
#     · **로그인**       → `/login` · 매장 데이터를 서버에 남길 수 있게 된다
#   버킷과 정책은 db/migrations/0002_media.sql 로 만든다.
#
#   ⚠️ 로그인은 **선택이다.** 이 칸이 비어 있으면 로그인 화면이 «설정 안 됨» 을
#     띄우고 첫 화면의 로그인 배지도 안 뜬다. 앱은 지금까지와 똑같이 돈다.
#     계정과 매장을 만드는 순서 → docs/deliverables/24_DB이관순서.md §2-A
#
#   없으면 서버가 로컬 파일(data/events.jsonl)에 쌓는데, **배포 환경에서는
#   그 파일이 요청 사이에 보존되지 않는다.** 즉 배포하고 나면 지표가 0건이다.
#   /api/log 의 응답에 `sink` 가 들어 있다 — 배포 점검에서 "db" 인지 볼 것.
#
#   ⚠️ 이 표에는 **이름도 금액도 담기지 않는다.** "채워졌는가"만 남긴다.
#     → db/migrations/0001_events.sql
#
#   ⚠️ NEXT_PUBLIC_ 을 붙이지 말 것. 서버 라우트에서만 읽는다.
#
#   키는 **익명(anon/publishable) 키**를 쓴다. 서비스 역할 키가 아니다 —
#   `events` 표의 정책상 익명 키로 할 수 있는 일은 **넣는 것뿐**이고 읽지 못한다.
#   `media` 버킷은 읽기·넣기·지우기를 하지만 **그 버킷 안으로만** 한정돼 있다.
#   서비스 역할 키를 넣으면 한 번 새는 순간 프로젝트 전부가 열린다.
#
#   값: Supabase 프로젝트 → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
