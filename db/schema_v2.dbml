// ===========================================================================
//  매장수첩 ERD v2  —  dbdiagram.io 용 DBML
//  2026-09-11
//
//  쓰는 법: dbdiagram.io 접속 → 왼쪽 편집창 전체 지우고 → 이 파일 통째로 붙여넣기
//           → 저장(Save) 하면 공유 링크가 나옵니다.
//
//  1차 설계에 대한 심사 지적 5건 + 자체 발견 2건을 반영했다.
//    1. 매장 간 데이터가 이어지는 문제 → 모든 참조를 (id, store_id) 복합키로
//    2. 원가 이력이 매입가에만 있는 문제 → 규격 전체를 기간 이력 + 레시피 판 번호
//    3. 계획과 실행이 안 이어지는 문제 → 날짜 3분화 + 실행행이 계획을 가리킨다
//    4. 접근 통제가 없는 문제 → 전 표에 줄 단위 통제 (DBML 로는 표현 안 되므로 주석)
//    5. 추천 근거가 안 남는 문제 → 실행 기록 + 입력값 스냅샷
//    A. 재료를 이름으로 잇던 문제 → items 가 재료 원본 명단
//    B. g 과 ml 이 섞이던 문제 → units 의 계열을 참조에 끼워 넣어 DB 가 막는다
//
//  2026-09-11 2차 피드백
//    C. 같은 매장은 보지만 같은 대상은 안 보던 관계 6곳 → 세 칸 외래키로
//    D. 단위 계열 검증이 빠진 곳 3곳 (규격 · 산출량 · 제조 수량)
// ===========================================================================

Project "매장수첩" {
  database_type: 'PostgreSQL'
  Note: '''
  # 매장수첩 v2 — 개인 카페·베이커리 매장 운영 도구

  ## 이 설계의 한 줄
  1차는 "같은 매장 것끼리만 이어진다"를 **프로그램이 판단**하게 두었다.
  2차는 그 판단을 **데이터베이스가 직접** 한다.

  ## 읽을 때 핵심
  모든 연결선이 `(id, store_id)` **두 칸**으로 이어진다.
  번호 하나로만 이으면 DB 는 "존재하는가"만 보고 "어느 매장인가"는 안 본다.

  ## 주의
  - 1차 DDL 원문 없이 재구성했다. **표·칸 이름은 1차와 대조가 필요하다.**
  - **실제 PostgreSQL 18 에서 29개 검사 전부 통과했다** (db/verify.js).
  '''
}

// ── 열거형 ────────────────────────────────────────────────────────────────
Enum unit_family {
  weight
  volume
  count
}
Enum item_kind {
  purchased
  made
}
Enum user_role {
  owner
  manager
  staff
}
Enum reco_kind {
  order
  bake
}


// ===========================================================================
//  1. 기준 · 매장
// ===========================================================================

Table units {
  code       text        [pk, note: 'g · kg · ml · L · 개']
  family     unit_family [not null, note: '무게 / 부피 / 개수']
  to_base    numeric     [not null, note: '계열 기준단위로의 배수']

  Indexes { (code, family) [unique, name: 'uq_units_code_family'] }
  Note: '''
  **B. g 과 ml 을 못 섞게 하는 뿌리.**
  밀도를 모르면 무게와 부피는 못 바꾼다 (밀가루 0.55 · 우유 1.03).
  바꾸면 원가가 틀리는데 사람이 못 알아챈다.
  아래 레시피 줄이 (품목, 매장, **계열**) 세 칸으로 품목을 가리켜서
  계열이 다른 단위를 적는 것 자체가 불가능해진다.
  '''
}

Table stores {
  id                  uuid [pk]
  name                text [not null]
  slug                text [unique, not null]
  timezone            text [not null, default: 'Asia/Seoul']
  business_day_start  time [not null, default: '04:00', note: '★ 매장의 하루는 자정이 아니라 새벽 4시에 바뀐다']
  created_at          timestamptz [not null, default: `now()`]

  Note: '마감조가 특별한 경우 01:00 까지 일한다. 달력 날짜로 집계하면 23:50 과 00:10 의 판매가 다른 날로 갈린다.'
}

Table users {
  id         uuid      [pk, note: '로그인 계정 (auth.users)']
  store_id   uuid      [not null]
  name       text      [not null]
  role       user_role [not null, default: 'staff']
  created_at timestamptz [not null, default: `now()`]

  Indexes { (id, store_id) [unique, name: 'uq_users_id_store'] }

  Note: '★ 지적 4 — 줄 단위 접근 통제의 기준점. 로그인한 사람의 store_id 로 모든 표를 거른다.'
}


// ===========================================================================
//  2. 거래처 · 품목 · 규격 이력
// ===========================================================================

Table suppliers {
  id            uuid [pk]
  store_id      uuid [not null]
  name          text [not null]
  phone         text
  contact       text
  order_method  text [note: '전화 · 카톡 · 앱 · 홈페이지']
  cutoff_time   time [note: '이 시각 넘기면 주문일이 하루 밀린다']
  delivery_days "smallint[]" [note: '0=일 … 6=토. 비면 매일']
  lead_days     int  [not null, default: 1]
  memo          text
  is_active     boolean [not null, default: true]
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique, name: 'uq_suppliers_id_store']
    (store_id, name) [unique]
  }
  Note: '일요일 배송을 하는 거래처가 거의 없어서, 금요일에 주말치까지 몰아 주문한다.'
}

Table items {
  id          uuid      [pk]
  store_id    uuid      [not null]
  supplier_id uuid      [note: '★ 같은 매장 거래처만 붙는다']
  name        text      [not null, note: '★ 매장 안에서 중복 금지']
  category    text
  kind        item_kind [not null, default: 'purchased', note: '사 오는 것 / 매장에서 만드는 부재료']
  base_unit   text      [not null]
  base_family unit_family [not null]
  is_active   boolean   [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique, name: 'uq_items_id_store']
    (store_id, name) [unique, name: 'uq_items_name']
    (id, store_id, base_family) [unique, name: 'uq_items_id_store_family']
    (id, store_id, kind) [unique, name: 'uq_items_id_store_kind']
  }
  Note: '''
  **★ A. 재료 원본 명단. 1차의 "이름으로 잇기" 를 여기서 끝낸다.**

  1차는 레시피의 재료 이름과 거래처 품목 이름을 **문자열로 맞췄다.**
  "우유" 와 "흰우유" 가 다르면 그 재료가 **원가에서 조용히 빠지고**,
  원가율이 실제보다 낮게 나오고, 점주가 그 숫자로 판매가를 정한다.

  v2 는 품목이 하나의 실체이고 레시피가 그 번호를 가리킨다.
  이름으로 맞추는 코드가 아예 없어진다.

  **kind = made** 가 필요한 이유: 바에서 만드는 부재료(르방·수제청·시럽·크림폼)가
  다시 다른 것의 재료가 된다. 르방은 식빵의 재료다.
  '''
}

Table item_versions {
  id          uuid [pk]
  store_id    uuid [not null]
  item_id     uuid [not null]
  unit_cost   numeric [not null, note: '한 팩 값 (원)']
  per_unit    numeric [not null, note: '그 팩의 수량 (1000)']
  pack_unit   text    [not null, note: '그 수량의 단위 (ml)']
  pack_family unit_family [not null]
  yield_count numeric [note: '만드는 품목의 1배합 산출 개수']
  is_tax_free boolean [not null, default: false]
  tax_rate    numeric [not null, default: 0.10]
  validity    daterange [not null, note: '★ 적용 구간. 끝이 비면 현재 유효']
  note        text
  created_at  timestamptz [not null, default: `now()`]
  created_by uuid

  Indexes {
    (id, store_id) [unique]
    (id, store_id, item_id) [unique, name: 'uq_item_versions_id_store_item']
    (item_id, validity)
  }
  Note: '''
  **★ 지적 2 — 1차는 매입가만 이력이었다.**

  팩 용량이 1000ml → 900ml 로 줄거나, 1배합 개수가 6 → 8 로 바뀌거나,
  면세가 과세로 돌아서면 **"3월 원가" 를 다시 뽑았을 때
  3월 가격 × 지금 규격** 이 섞인 숫자가 나온다. 그리고 틀렸다는 표시가 어디에도 안 뜬다.

  그래서 원가에 들어가는 값을 **한 줄에 통째로, 기간과 함께** 담는다.

  **겹침 금지 제약이 걸린다** (EXCLUDE USING gist).
  시작·끝을 칸 두 개로 두면 "3/1~" 과 "2/15~" 가 둘 다 살아 있어도 통과하고,
  그러면 어느 값을 쓸지 조회가 마음대로 고른다.
  '''
}


// ===========================================================================
//  3. 메뉴 · 판매가 이력
// ===========================================================================

Table menus {
  id        uuid [pk]
  store_id  uuid [not null]
  name      text [not null]
  category  text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique]
    (store_id, name) [unique]
  }
}

Table menu_prices {
  id          uuid [pk]
  store_id    uuid [not null]
  menu_id     uuid [not null]
  price       numeric [not null]
  is_tax_free boolean [not null, default: false]
  validity    daterange [not null]

  Note: '판매가도 이력이다 — 원가율의 분모이기 때문이다. 가격을 올린 뒤 과거 원가율을 뽑으면 지금 가격으로 계산돼 실제보다 좋아 보인다.'
}


// ===========================================================================
//  4. 레시피 — 판 번호 구조 (지적 2의 뒷부분)
// ===========================================================================

Table menu_recipe_versions {
  id         uuid [pk]
  store_id   uuid [not null]
  menu_id    uuid [not null]
  version    int  [not null, note: '판 번호']
  valid_from date [not null]
  valid_to   date [note: '비면 현재 판']
  note       text [note: '"원두 1g 줄임" 같은 변경 사유']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique]
    (id, store_id, menu_id) [unique, name: 'uq_mrv_id_store_menu']
    (menu_id, version) [unique]
  }
  Note: '''
  **왜 "쓰는 중/안 쓰는 중" 표시가 아니라 판 번호인가**

  - `is_active` 만 두면 재료를 뺀 사실은 남지만 **언제 뺐는지**가 안 남는다.
  - 줄마다 종료일을 두면 표현은 되는데 **"3월 15일자 레시피 전체"** 를 한 번에 집기 어렵다.
  - 판으로 두면 판매 기록이 **판 번호 하나만 들면** 그 시점 레시피가 통째로 고정되고,
    **재료 제거도 자연히 표현된다** (다음 판에 그 줄이 없다).
  '''
}

Table menu_recipe_lines {
  id                 uuid [pk]
  store_id           uuid [not null]
  version_id         uuid [not null]
  item_id            uuid [not null, note: '★ 재료 원본 명단을 번호로 가리킨다']
  amount             numeric [not null]
  unit               text [not null]
  unit_family        unit_family [not null, note: '★ 품목의 기준단위 계열과 같아야 한다']
  excluded_from_cost boolean [not null, default: false, note: '★ "추출량" 처럼 원가에서 빼는 줄']

  Indexes { (version_id, item_id) [unique] }
  Note: '''
  **★ excluded_from_cost 를 빼먹으면 원두가 두 번 계산된다.**
  아메리카노에 "원두(도징) 18g" 과 "추출량 36g" 이 둘 다 있는데,
  추출량은 **사는 게 아니라 결과**다.
  '''
}

Table make_recipe_versions {
  id              uuid [pk]
  store_id        uuid [not null]
  item_id         uuid [not null, note: '만들어지는 품목 (kind = made)']
  version         int  [not null]
  yield_amount    numeric [not null, note: '1배합 산출량']
  yield_unit      text [not null]
  yield_family    unit_family [not null]
  lead_time_hours numeric [note: '★ 걸어놓고 몇 시간 뒤에 쓸 수 있나']
  recoverable     boolean [not null, default: true, note: '★ 돈으로 되돌릴 수 있나']
  valid_from      date [not null]
  valid_to        date
  note            text
  created_at      timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique]
    (id, store_id, item_id) [unique, name: 'uq_krv_id_store_item']
    (item_id, version) [unique]
  }
  Note: '''
  **★ 이 두 칸이 이 제품의 존재 이유다.**

  콜드브루 추출 12~24h · 반죽 냉장 12~18h · 르방 갱신 매일(복구 2~3일) · 냉동생지 해동 12h.
  **오늘은 아무 일도 안 일어나고 내일 아침에 터진다.**
  신입이 스스로 알 방법이 없고, 어제 뭘 걸어놨는지 기억에 의존하므로 종이로는 못 잡는다.

  `recoverable = false` 인 것만 화면이 빨갛게 띄운다 —
  **전부 경고하면 사람은 전부 무시하기 때문이다.**
  '''
}

Table make_recipe_lines {
  id                 uuid [pk]
  store_id           uuid [not null]
  version_id         uuid [not null]
  ingredient_item_id uuid [not null]
  amount             numeric [not null]
  unit               text [not null]
  unit_family        unit_family [not null]
  excluded_from_cost boolean [not null, default: false]

  Indexes { (version_id, ingredient_item_id) [unique] }
  Note: '★ 지적 1 — 다른 매장 재료로 제조 레시피를 구성할 수 없다.'
}


// ===========================================================================
//  5. 계획 — 지적 3의 앞부분 (날짜를 셋으로 나눈다)
// ===========================================================================

Table order_plans {
  id           uuid [pk]
  store_id     uuid [not null]
  item_id      uuid [not null]
  supplier_id  uuid
  run_id       uuid [note: '★ 지적 5 — 어느 추천에서 나왔나']
  planned_on   date [not null, note: '계획을 세운 날']
  expected_on  date [note: '★ 들어올 예정일 — 거래처 마감·배송요일·리드타임으로 계산']
  qty          numeric [not null]
  unit         text [not null]
  unit_family  unit_family [not null]
  memo         text
  cancelled_at timestamptz
  created_at   timestamptz [not null, default: `now()`]
  created_by uuid

  Indexes {
    (id, store_id) [unique]
    (id, store_id, item_id) [unique, name: 'uq_order_plans_id_store_item']
  }
  Note: '1차는 "확정일" 한 칸이었다. 주문한 날과 도착할 날이 따로 있어야 "금요일에 주말치까지 몰아서" 가 표현된다.'
}

Table bake_plans {
  id                     uuid [pk]
  store_id               uuid [not null]
  item_id                uuid [not null]
  make_recipe_version_id uuid
  run_id                 uuid
  planned_on             date [not null]
  expected_on            date [note: '리드타임을 더한 사용 가능 시점']
  batches                numeric [not null, note: '배수 (1.5배)']
  memo                   text
  cancelled_at           timestamptz
  created_at             timestamptz [not null, default: `now()`]
  created_by uuid

  Indexes {
    (id, store_id) [unique]
    (id, store_id, item_id) [unique, name: 'uq_bake_plans_id_store_item']
    (id, store_id, make_recipe_version_id) [unique, name: 'uq_bake_plans_id_store_recipe']
  }
}


// ===========================================================================
//  6. 원장 — 실제로 일어난 일
// ===========================================================================

Table daily_sales {
  id            uuid [pk]
  store_id      uuid [not null]
  business_date date [not null, note: '★ 달력 날짜가 아니라 영업일 (새벽 4시 경계)']
  total_amount  numeric [note: 'POS 합계 — 대조용']
  ticket_count  int
  memo          text
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    (id, store_id) [unique]
    (store_id, business_date) [unique]
  }
}

Table sales_lines {
  id                     uuid [pk]
  store_id               uuid [not null]
  daily_sales_id         uuid [not null]
  menu_id                uuid [not null, note: '★ 같은 매장 메뉴만']
  qty                    numeric [not null]
  unit_price             numeric
  menu_recipe_version_id uuid [note: '★ 그때 그 레시피 판. 나중에 고쳐도 과거 원가가 안 흔들린다']

  Note: '★ 지적 1 — 1차에서는 A매장 하루 기록에 B매장 메뉴가 팔린 것으로 남을 수 있었다.'
}

Table received_lines {
  id              uuid [pk]
  store_id        uuid [not null]
  item_id         uuid [not null]
  supplier_id     uuid
  order_plan_id   uuid [note: '★ 지적 3 — 어느 발주 계획이 이행된 것인가. 비워 둘 수 있다']
  item_version_id uuid [note: '그때 규격']
  occurred_on     date [not null, note: '실제 들어온 날']
  qty             numeric [not null]
  unit            text [not null]
  unit_family     unit_family [not null]
  unit_cost       numeric
  memo            text
  created_at      timestamptz [not null, default: `now()`]

  Note: '''
  **order_plan_id 를 비워 둘 수 있게 한 것은 일부러다.**
  계획 없이 급하게 받은 입고가 실제로 있다 — 쿠팡으로 메운 것 같은.
  못 넣게 하면 사람이 장부를 아예 안 쓴다.

  그리고 **계획 한 줄에 여러 번 나눠 들어올 수 있어서**,
  계획 쪽이 아니라 **실행 쪽이 계획을 가리킨다.**
  '''
}

Table baked_lines {
  id                     uuid [pk]
  store_id               uuid [not null]
  item_id                uuid [not null]
  bake_plan_id           uuid [note: '★ 지적 3']
  make_recipe_version_id uuid
  occurred_on            date [not null]
  started_at             timestamptz [note: '걸어둔 시각 — 리드타임의 시작']
  ready_at               timestamptz [note: '★ 쓸 수 있게 되는 시각']
  batches                numeric [not null]
  qty                    numeric
  unit                   text [not null]
  unit_family            unit_family [not null, note: '★ 2차 피드백 2 — 이 칸이 없었다']
  memo                   text
  created_at             timestamptz [not null, default: `now()`]
}

Table waste_lines {
  id          uuid [pk]
  store_id    uuid [not null]
  item_id     uuid [not null]
  occurred_on date [not null]
  qty         numeric [not null]
  unit        text [not null]
  unit_family unit_family [not null]
  reason      text [note: '유통기한 · 품질 · 실수 · 시식']
  memo        text
  created_at  timestamptz [not null, default: `now()`]
}

Table stock_counts {
  id          uuid [pk]
  store_id    uuid [not null]
  item_id     uuid [not null]
  counted_on   date [not null]
  qty          numeric [not null]
  was_stockout boolean [not null, default: false, note: '★ 그날 도중 품절됐는가 — 품절일 판매량은 수요가 아니라 재고 한계다']
  unit        text [not null]
  unit_family unit_family [not null]
  counted_by  uuid
  memo        text
  created_at  timestamptz [not null, default: `now()`]

  Indexes { (store_id, item_id, counted_on) [unique] }
}


// ===========================================================================
//  7. 추천 근거 — 지적 5
// ===========================================================================

Table recommendation_runs {
  id           uuid [pk]
  store_id     uuid [not null]
  ran_at       timestamptz [not null, default: `now()`]
  ran_by       uuid
  kind         reco_kind [not null]
  algo_version text [not null, note: '★ 계산식 판 번호. 코드에서 상수로 보낸다']
  params       jsonb [not null, note: '안전재고일수 · 리드타임 · 반올림 단위']
  horizon_from date [not null, note: '무엇을 근거로 본 기간']
  horizon_to   date [not null]

  Indexes { (id, store_id) [unique] }
  Note: '''
  **"그때 다시 계산해 보면 되지 않나" 가 안 되는 이유는 원장이 움직이기 때문이다.**
  판매가 정정되고, 단가 이력이 나중에 소급 입력되고, 계산식이 바뀐다.

  그리고 **"왜 그때 12개를 시켰나" 를 묻는 순간은 거의 항상 사고가 난 다음이다** —
  재고가 터졌거나 폐기가 났거나. 그때 재현이 안 되면 원인을 영영 못 찾는다.
  '''
}

Table recommendation_inputs {
  run_id          uuid [not null]
  store_id        uuid [not null]
  item_id         uuid [not null]
  sold_qty        numeric [not null, note: '그때 판매량']
  waste_qty       numeric [not null, default: 0]
  on_hand         numeric [not null, note: '그때 재고']
  unit_cost       numeric [note: '그때 단가']
  item_version_id uuid
  lead_days       int
  safety_days     numeric
  demand_avg             numeric [note: '기간 하루 평균 (예: 우유 1,200ml/일)']
  stockout_days_excluded int     [note: '품절이라 평균에서 뺀 날 수']
  weekday_adjust         numeric [note: '요일 보정 (예: 금요일에 주말치까지)']
  round_unit             numeric [note: '반올림 단위 (예: 우유 1,000ml 팩)']
  recommended_qty numeric [not null]
  reason          text [note: '★ 사람이 읽는 한 줄']

  Indexes { (run_id, item_id) [pk] }
  Note: '''
  **★ reason 한 칸이 나머지 전부보다 실전에서 쓸모 있다.**

  점주가 보는 것은 숫자 열 개가 아니라 문장 하나다.
  `최근 14일 하루 평균 1,200ml · 현재고 800ml · 리드타임 1일 · 안전재고 1일 → 3팩`
  처럼 **계산 결과가 아니라 계산 과정**을 문장으로 남긴다.

  나머지 칸은 개발자가 보는 것이고, 이 한 줄은
  **점주가 추천을 믿을지 말지 정하는 근거**다.
  '''
}


// ===========================================================================
//  관계 — ★ 전부 (id, store_id) 복합키다. 이게 지적 1의 답이다.
// ===========================================================================

// 매장 · 사용자 — ★ 모든 표가 매장에 매달린다
Ref: users.store_id          > stores.id
Ref: suppliers.store_id      > stores.id
Ref: items.store_id          > stores.id
Ref: menus.store_id          > stores.id
Ref: order_plans.store_id    > stores.id
Ref: bake_plans.store_id     > stores.id
Ref: daily_sales.store_id    > stores.id
Ref: received_lines.store_id > stores.id
Ref: baked_lines.store_id    > stores.id
Ref: waste_lines.store_id    > stores.id
Ref: stock_counts.store_id   > stores.id

// 단위 계열 — ★ B. g 과 ml 을 못 섞게 한다
Ref: items.(base_unit, base_family)          > units.(code, family)
Ref: item_versions.(pack_unit, pack_family)  > units.(code, family)
Ref: menu_recipe_lines.(unit, unit_family)   > units.(code, family)
Ref: make_recipe_lines.(unit, unit_family)   > units.(code, family)
Ref: order_plans.(unit, unit_family)         > units.(code, family)
Ref: received_lines.(unit, unit_family)      > units.(code, family)
Ref: waste_lines.(unit, unit_family)         > units.(code, family)
Ref: stock_counts.(unit, unit_family)        > units.(code, family)

// 거래처 · 품목 — ★ 지적 1
Ref: items.(supplier_id, store_id)         > suppliers.(id, store_id)
// ★ 2차 피드백 2 — 규격 단위 계열이 품목 기준 계열과 같아야 한다
Ref: item_versions.(item_id, store_id, pack_family) > items.(id, store_id, base_family)

// 메뉴 · 레시피
Ref: menu_prices.(menu_id, store_id)                 > menus.(id, store_id)
Ref: menu_recipe_versions.(menu_id, store_id)        > menus.(id, store_id)
Ref: menu_recipe_lines.(version_id, store_id)        > menu_recipe_versions.(id, store_id)
// ★ 2차 피드백 2 — 산출 단위 계열도 품목 기준 계열과 같아야 한다
Ref: make_recipe_versions.(item_id, store_id, yield_family) > items.(id, store_id, base_family)
Ref: make_recipe_versions.(yield_unit, yield_family)        > units.(code, family)
Ref: make_recipe_lines.(version_id, store_id)        > make_recipe_versions.(id, store_id)

// ★ 레시피 줄 → 품목: 매장과 계열까지 세 칸으로 맞춘다 (지적 1 + B 를 한 번에)
Ref: menu_recipe_lines.(item_id, store_id, unit_family)            > items.(id, store_id, base_family)
Ref: make_recipe_lines.(ingredient_item_id, store_id, unit_family) > items.(id, store_id, base_family)

// 계획
Ref: order_plans.(item_id, store_id, unit_family)   > items.(id, store_id, base_family)
Ref: order_plans.(supplier_id, store_id)            > suppliers.(id, store_id)
Ref: bake_plans.(item_id, store_id)                 > items.(id, store_id)
// ★ 2차 피드백 1 — 제조 계획의 레시피가 그 품목의 레시피여야 한다
Ref: bake_plans.(make_recipe_version_id, store_id, item_id) > make_recipe_versions.(id, store_id, item_id)

// 원장
Ref: sales_lines.(daily_sales_id, store_id)          > daily_sales.(id, store_id)
Ref: sales_lines.(menu_id, store_id)                 > menus.(id, store_id)
// ★ 2차 피드백 1 — 아메리카노 판매에 라떼 레시피를 못 붙인다
Ref: sales_lines.(menu_recipe_version_id, store_id, menu_id) > menu_recipe_versions.(id, store_id, menu_id)
Ref: received_lines.(item_id, store_id, unit_family) > items.(id, store_id, base_family)
Ref: received_lines.(supplier_id, store_id)          > suppliers.(id, store_id)
// ★ 2차 피드백 1 — 다른 품목의 규격을 못 붙인다
Ref: received_lines.(item_version_id, store_id, item_id) > item_versions.(id, store_id, item_id)
// ★ 2차 피드백 2 — 생산 수량의 단위 계열 검증
Ref: baked_lines.(item_id, store_id, unit_family)    > items.(id, store_id, base_family)
Ref: baked_lines.(unit, unit_family)                 > units.(code, family)
Ref: baked_lines.(make_recipe_version_id, store_id, item_id) > make_recipe_versions.(id, store_id, item_id)
Ref: waste_lines.(item_id, store_id, unit_family)    > items.(id, store_id, base_family)
Ref: stock_counts.(item_id, store_id, unit_family)   > items.(id, store_id, base_family)

// ★ 지적 3 — 실행이 계획을 가리킨다
// ★ 2차 피드백 1 — 우유 입고에 원두 발주 계획을 못 붙인다
Ref: received_lines.(order_plan_id, store_id, item_id) > order_plans.(id, store_id, item_id)
Ref: baked_lines.(bake_plan_id, store_id, item_id)     > bake_plans.(id, store_id, item_id)
// ★ 전수 훑기 — 계획과 레시피를 둘 다 가리키면 그 계획의 레시피여야 한다
Ref: baked_lines.(bake_plan_id, store_id, make_recipe_version_id) > bake_plans.(id, store_id, make_recipe_version_id)

// ★ 지적 5 — 계획이 추천을 가리킨다
Ref: recommendation_runs.store_id                      > stores.id
Ref: order_plans.(run_id, store_id)                    > recommendation_runs.(id, store_id)

// ── ★ 3차 피드백 — 기록을 남긴 사람도 같은 매장이어야 한다 ────────────
//    전에는 이 칸들에 참조가 하나도 없었다. 아무 번호나 적혔고,
//    "B매장 직원이 A매장 재고를 셌다" 가 그대로 저장됐다.
//    기록을 만든 **계정**은 users, 실제로 손을 댄 **직원**은 staff 다.
Ref: item_versions.(created_by, store_id)      > users.(id, store_id)
Ref: order_plans.(created_by, store_id)        > users.(id, store_id)
Ref: bake_plans.(created_by, store_id)         > users.(id, store_id)
Ref: recommendation_runs.(ran_by, store_id)    > users.(id, store_id)
Ref: stock_counts.(counted_by, store_id)       > staff.(id, store_id)
Ref: bake_plans.(run_id, store_id)                     > recommendation_runs.(id, store_id)
Ref: recommendation_inputs.(run_id, store_id)          > recommendation_runs.(id, store_id)
Ref: recommendation_inputs.(item_id, store_id)         > items.(id, store_id)
// ★ 2차 피드백 1 — 추천 대상 품목의 규격이어야 한다
Ref: recommendation_inputs.(item_version_id, store_id, item_id) > item_versions.(id, store_id, item_id)


// ===========================================================================
//  그룹 — dbdiagram 에서 색으로 묶여 보인다
// ===========================================================================

TableGroup "기준 · 매장" {
  units
  stores
  users
}

TableGroup "거래처 · 품목" {
  suppliers
  items
  item_versions
}

TableGroup "메뉴 · 레시피" {
  menus
  menu_prices
  menu_recipe_versions
  menu_recipe_lines
  make_recipe_versions
  make_recipe_lines
}

TableGroup "계획" {
  order_plans
  bake_plans
}

TableGroup "원장" {
  daily_sales
  sales_lines
  received_lines
  baked_lines
  waste_lines
  stock_counts
}

TableGroup "추천 근거" {
  recommendation_runs
  recommendation_inputs
}


// ===========================================================================
//  ⚠️ DBML 로 표현할 수 없어 여기 적어 두는 것
//
//  1. 줄 단위 접근 통제 (지적 4)
//     37개 표 전부에 "로그인한 사람의 매장 줄만" 정책을 건다.
//     ★ 직원 이름·전화·근무시간·급여가 들어 있는 표(staff · shift_assignments ·
//       punches · contracts · daily_checks)가 특히 그렇다 — 여기가 빠지면
//       다른 매장의 민감정보가 그대로 보인다. db/sweep.js 규칙 5 가 매번 전수로 확인한다.
//     읽기 조건과 쓰기 조건을 **둘 다** 걸어야 한다 —
//     읽기 조건만 걸면 새로 넣는 것은 그대로 통과한다.
//     그리고 표 주인에게도 적용되도록 강제 옵션을 같이 켠다.
//     → db/schema_v2.sql 11절
//
//  2. 기간 겹침 금지 (지적 2)
//     item_versions 와 menu_prices 의 validity 가 같은 대상끼리 겹칠 수 없다.
//     EXCLUDE USING gist (item_id WITH =, validity WITH &&)
//     → db/schema_v2.sql 4절 · 5절
//
//  3. 이행 상태는 저장하지 않고 뷰로 계산한다 (지적 3)
//     "완료 / 부분입고 / 미이행 / 초과입고" 를 칸으로 만들면
//     실행이 들어올 때마다 사람이 갱신해야 하고 반드시 원장과 어긋난다.
//     → db/schema_v2.sql 10절 v_order_fulfillment · v_bake_fulfillment
//
//  4. 확인 필요
//     · 1차 DDL 원문 없이 재구성했다. 표·칸 이름 대조 필요
//     · 고유번호를 uuid 로 가정했다. 숫자형이면 전부 바꿔야 한다
//     · 실제 DB 에서 아직 실행해 본 적 없다
// ===========================================================================

// ===========================================================================
//  3차 추가 — 매장 운영 13표
//  2차까지는 원가·재고·발주 축만 있었다. 이 제품의 나머지 절반을 여기서 채운다.
// ===========================================================================

Table positions {
  id         uuid [pk]
  store_id   uuid [not null]
  share_slug text [not null, note: '/p/{slug} · /t/{slug} 주소가 된다']
  name       text [not null]
  subtitle   text
  summary    text
  sort_order int
  is_active  boolean [not null, default: true]
  created_at timestamptz

  Indexes {
    (id, store_id) [unique]
    (store_id, share_slug) [unique]
  }
  Note: '체크리스트와 교육 모드가 같은 포지션을 쓴다. 신입이 첫날 여는 화면.'
}

Table sections {
  id       uuid [pk]
  store_id uuid [not null]
  position_id            uuid [note: '포지션의 섹션']
  menu_recipe_version_id uuid [note: '메뉴 레시피의 만드는 순서']
  make_recipe_version_id uuid [note: '제조 레시피의 만드는 순서']
  title      text [not null]
  note       text
  sort_order int

  Indexes { (id, store_id) [unique] }
  Note: '''
  **주인은 셋 중 하나뿐이다** (CHECK 로 강제).
  화면 셋 — 체크리스트 · 교육 모드 · 레시피의 만드는 순서 — 이 같은 모양을 쓰기 때문에
  공통으로 두고 주인만 나눴다. 재료와 순서는 한 몸이라 레시피도 여기를 쓴다.
  '''
}

Table steps {
  id         uuid [pk]
  store_id   uuid [not null]
  section_id uuid [not null]
  title      text [not null]
  descr      text [note: 'desc 는 예약어라 descr']
  tip        text [note: '선배가 덧붙이는 한마디']
  critical   boolean [not null, default: false, note: '건너뛰면 안 되는 것 (위생·안전)']
  good_image text [note: '이렇게 되면 맞다']
  bad_image  text [note: '★ 기준이 안 맞는 항목일수록 이쪽이 중요하다']
  video_url  text
  sort_order int

  Indexes { (id, store_id) [unique] }
}

Table prep_lists {
  id       uuid [pk]
  store_id uuid [not null]
  slug     text [not null, note: 'afternoon · evening · cycle']
  name     text [not null]
  note     text
  sort_order int

  Indexes {
    (id, store_id) [unique]
    (store_id, slug) [unique]
  }
}

Table prep_tasks {
  id       uuid [pk]
  store_id uuid [not null]
  list_id  uuid [not null]
  title    text [not null]
  descr    text

  kind text [not null, note: 'time · order · cycle · routine']

  trigger_type text [not null, note: 'daily · weekday · condition · cycle']
  trigger_at   time
  trigger_days "smallint[]" [note: '0=일 … 6=토']
  trigger_when text [note: '사람이 읽는 문장']

  lead_time_hours numeric [note: '걸어놓고 몇 시간 뒤 (콜드브루 · 반죽)']
  lead_time_days  int     [note: '주문하면 며칠 뒤']

  recoverable boolean [not null, default: true, note: '★ 돈으로 되돌릴 수 있나']
  consequence text    [not null, note: '안 하면 무슨 일이 생기나']
  quantity_varies boolean [not null, default: false, note: '매일 수량이 달라짐 = 종이로 못 하는 이유']
  critical    boolean [not null, default: false]

  good_image text
  bad_image  text
  video_url  text

  menu_id          uuid [note: '이 프렙이 따라가는 메뉴 레시피']
  make_recipe_item uuid [note: '만드는 부재료. 아래 참조가 items.kind = made 를 강제한다']

  option_of uuid    [note: '★ 딸린 옵션이면 부모 항목. 옵션의 옵션은 없다']
  optional  boolean [not null, default: false, note: '★ 진행률 분모에 들어가나 (배치가 아니라 셈)']

  is_option             boolean [note: '계산되는 칸(generated) — option_of 가 있으면 true. 사람이 못 넣는다']
  option_parent_is_root boolean [note: '계산되는 칸(generated) — 항상 false. 부모가 옵션이 아님을 외래키로 강제하는 장치']
  made_kind             text    [note: '계산되는 칸(generated) — 항상 made. 아래 참조가 items.kind 와 맞춰서 만드는 부재료만 붙게 한다']
  sort_order int
  created_at timestamptz

  Indexes {
    (id, store_id) [unique]
    (id, store_id, is_option) [unique, name: 'uq_prep_tasks_id_store_opt']
    (id, store_id, list_id) [unique, name: 'uq_prep_tasks_id_store_list']
  }
  Note: '''
  **이 제품이 종이를 이긴다고 주장하는 곳.**

  콜드브루 12~24h · 반죽 냉장 12~18h · 르방 갱신 매일(복구 2~3일).
  **오늘은 아무 일도 안 일어나고 내일 아침에 터진다.**

  · `recoverable = false` 인 것만 화면이 빨갛게 띄운다 — 전부 경고하면 사람은 전부 무시한다
  · `kind = routine` 은 리드타임이 **없다**. 있으면 화면이 없는 약속을 만든다 (CHECK 로 막음)
  · 되돌릴 수 없는 것은 **이유를 반드시 적어야 한다** (CHECK 로 막음)
  · `optionOf` 는 **배치**(어느 카드 안에), `optional` 은 **셈**(진행률 분모에). 다른 것이다

  ★ **`is_option` · `option_parent_is_root` · `made_kind` 는 사람이 넣는 칸이 아니다.**
  DB 가 계산한다(`GENERATED ALWAYS AS … STORED`). 손으로 넣으면 거부된다.
  **DBML 에는 그 문법이 없어서** 그림에서는 평범한 칸으로 보인다 — 정본은 `schema_v2.sql` 이다.
  이 세 칸은 값을 쓰라고 있는 게 아니라 **외래키가 기댈 상수**를 만들려고 있다.
  '''
}

Table prep_cycle_state {
  store_id   uuid [not null]
  task_id    uuid [not null]
  last_done  date [note: 'null = 기록 없음. 0 이나 큰 수로 채우지 않는다']
  every_days int  [note: '매장이 정한 주기. 비면 기한을 판단하지 않는다']
  updated_at timestamptz

  Indexes { (store_id, task_id) [pk] }
  Note: '''
  **"그날 체크" 가 아니라 "마지막으로 한 날" 을 남긴다.**
  날짜별 키에 넣으면 다음 날 지워져서 주기를 아예 못 센다.

  `every_days` 는 시드에 없다 — 쓰는 곳마다 다르기 때문이다.
  제빙기를 매일 닦는 매장에 "1개월마다" 를 띄우면 처음부터 틀린 말이다.
  비어 있으면 "마지막 5/11 · 121일 전" 만 보여준다.
  '''
}

Table shifts {
  id       uuid [pk]
  store_id uuid [not null]
  name     text [not null, note: '제빵 · 오픈조 · 미들 · 마감조']
  start_at time [not null]
  end_at   time [not null, note: '★ 자정을 넘을 수 있다 (end < start 허용)']
  note     text
  sort_order int

  Indexes { (id, store_id) [unique] }
  Note: '부가 기능이 아니다. 태블릿을 켰을 때 어느 화면을 먼저 띄울지 고르는 기준이다.'
}

Table shift_focus {
  id       uuid [pk]
  store_id uuid [not null]
  shift_id uuid [not null]
  kind     text [not null, note: 'training · checklist · prep · recipes']
  position_id  uuid
  prep_list_id uuid
  label    text [not null]
  sort_order int [note: '첫 번째가 대표']
}

Table staff {
  id       uuid [pk]
  store_id uuid [not null]
  name     text [not null]
  section  text [note: '제빵 · 바 · 홀 · 주방']
  email    text [note: '근무표를 보낼 주소. 없으면 발송 대상에서 빠진다']
  phone    text
  user_id  uuid [unique, note: '★ 로그인 계정 하나에 직원 한 명. 비어 있는 것은 여럿 허용 — 알바는 대부분 계정이 없다']
  is_active boolean [not null, default: true]
  created_at timestamptz

  Indexes {
    (id, store_id) [unique]
    (user_id, store_id) [unique, name: 'uq_staff_user_store']
  }
  Note: '★ users 는 로그인 계정이라 직원과 다르다. 알바는 대부분 로그인하지 않는다.'
}

Table shift_assignments {
  store_id      uuid [not null]
  staff_id      uuid [not null]
  business_date date [not null]
  shift_id      uuid [note: 'null = 휴무']
  memo          text

  Indexes { (store_id, staff_id, business_date) [pk] }
  Note: '근무표(계획). 출퇴근(실제)과의 차이가 근태가 된다.'
}

Table punches {
  id       uuid [pk]
  store_id uuid [not null]
  staff_id uuid [not null]
  business_date date [not null, note: '★ 달력 날짜가 아니라 영업일']
  in_at  time [note: '비어 있으면 아직 출근 안 찍음']
  out_at time [note: '비어 있으면 근무 중']
  crosses_midnight boolean [not null, default: false, note: '★ 23:00→01:00 을 그냥 빼면 −22시간이다']
  break_min int [not null, default: 0, note: '근로시간에서 뺀다']
  note text
  created_at timestamptz

  Indexes { (store_id, staff_id, business_date) [unique] }
  Note: '★ 근로기준법 제42조 — 3년 보존 대상.'
}

Table contracts {
  id       uuid [pk]
  store_id uuid [not null]
  staff_id uuid [not null]
  start_date  date [not null]
  end_date    date [note: '비면 기간의 정함이 없는 근로계약']
  hourly_wage numeric [not null]
  weekly_hours numeric [note: '주휴수당 계산에 쓰는 1주 소정근로시간']
  work_days   "smallint[]"
  work_start  time
  work_end    time
  memo text
  created_at timestamptz

  Indexes { (id, store_id) [unique] }
  Note: '''
  ★ 근로기준법 제42조 — 3년 보존 대상.

  **주민등록번호 칸을 만들지 않았다.** 개인정보보호법 제24조의2 가 암호화를 요구한다.
  계약서 원본은 앱 밖에 두고, 이 표는 **계산에 필요한 조건**만 담는다.
  '''
}

Table store_settings {
  store_id uuid [pk]
  min_wage numeric [not null, note: '2026년 고시액 10,320']
  five_or_more boolean [not null, default: false, note: '★ 5인 미만은 연장 가산수당이 없다 (제11조)']
  target_cost_rate numeric [not null, default: 30]
  updated_at timestamptz

  Note: '해마다 바뀌는 숫자를 코드에 안 박는다. 박아두면 내년에 조용히 틀린 경고를 준다.'
}

Table cost_excluded_items {
  store_id uuid [not null]
  item_id  uuid [not null]
  reason   text

  Indexes { (store_id, item_id) [pk] }
  Note: '★ "추출량" 이 여기 해당한다 — 아메리카노에 원두 18g 과 추출량 36g 이 둘 다 있는데 추출량은 사는 게 아니라 결과다. 안 빼면 원두를 두 번 센다.'
}

Table daily_checks {
  id            uuid [pk, note: '★ 3차 피드백 — 한 줄을 가리킬 수 있어야 나중에 그 체크만 지운다']
  store_id      uuid [not null]
  business_date date [not null, note: '★ 새벽 4시 경계']
  step_id       uuid [note: '체크리스트']
  prep_task_id  uuid [note: '프렙']
  checked_at    timestamptz
  checked_by    uuid [note: '체크한 직원. 같은 매장 직원만 적힌다']

  Indexes {
    (store_id, business_date, step_id) [unique, name: 'uq_daily_checks_step']
    (store_id, business_date, prep_task_id) [unique, name: 'uq_daily_checks_prep']
  }
  Note: '''
  **★ 3차 피드백 — 셋을 한꺼번에 막는다.**

  · `step_id` 와 `prep_task_id` 는 **둘 다 비거나 둘 다 차면 거부**된다 (`ck_daily_checks_one`).
    한 줄은 체크리스트 한 칸 **또는** 프렙 한 칸이고, 둘 다는 말이 안 된다
  · 같은 날 같은 칸을 두 번 체크하면 거부된다 (위 두 인덱스. SQL 에서는 한쪽이 빈 줄만 세는 부분 인덱스다)
  · 체크 취소는 **줄을 지운다.** "체크했다 풀었다" 이력은 지금 화면에 없는 기능이라 만들지 않았다

  지금 앱은 이것을 영업일이 바뀌면 버린다(브라우저에만 있어서).
  서버로 오면 남길 수 있고, 남겨야 한다 — **"기록" 이 이 제품의 세 가치 중 하나**다.

  ★ 교육 모드는 여기 안 쌓는다. 공용 태블릿이라 앞사람 진도가 다음 신입에게 보이면 안 된다.
  '''
}

// ── 3차 관계 ───────────────────────────────────────────────────────────
Ref: positions.store_id  > stores.id
Ref: prep_lists.store_id > stores.id
Ref: shifts.store_id     > stores.id
Ref: staff.store_id      > stores.id
Ref: punches.store_id    > stores.id
Ref: contracts.store_id  > stores.id
Ref: sections.store_id   > stores.id
Ref: steps.store_id      > stores.id
Ref: prep_tasks.store_id > stores.id
Ref: prep_cycle_state.store_id > stores.id
Ref: daily_checks.store_id > stores.id
// 매장 하나에 설정 한 줄 — 1:1 이므로 '-'
Ref: store_settings.store_id - stores.id
// 로그인 계정 하나에 직원 한 명 — 1:1 (대부분의 알바는 계정이 없어서 비어 있다)
// ★ 전수 훑기가 찾은 것 — 매장까지 맞춰야 한다. A매장 직원이 B매장 계정에 붙으면 안 된다
Ref: staff.(user_id, store_id) - users.(id, store_id)

Ref: sections.(position_id, store_id)            > positions.(id, store_id)
Ref: sections.(menu_recipe_version_id, store_id) > menu_recipe_versions.(id, store_id)
Ref: sections.(make_recipe_version_id, store_id) > make_recipe_versions.(id, store_id)
Ref: steps.(section_id, store_id)                > sections.(id, store_id)

Ref: prep_tasks.(list_id, store_id)          > prep_lists.(id, store_id)
Ref: prep_tasks.(menu_id, store_id)          > menus.(id, store_id)
// ★ 3차 피드백 — 전에는 아무 품목이나 붙었다. 이제 kind = made 만 붙는다
Ref: prep_tasks.(make_recipe_item, store_id, made_kind) > items.(id, store_id, kind)
// ★ 옵션의 옵션 금지 — 부모의 is_option 이 false 여야만 통과한다
Ref: prep_tasks.(option_of, store_id, option_parent_is_root) > prep_tasks.(id, store_id, is_option)
// ★ 전수 훑기 — 옵션은 부모와 같은 목록 안에 있어야 한다
Ref: prep_tasks.(option_of, store_id, list_id) > prep_tasks.(id, store_id, list_id)
// 프렙 항목 하나에 주기 기록 한 줄 — 1:1
Ref: prep_cycle_state.(task_id, store_id) - prep_tasks.(id, store_id)

Ref: shift_focus.(shift_id, store_id)     > shifts.(id, store_id)
Ref: shift_focus.(position_id, store_id)  > positions.(id, store_id)
Ref: shift_focus.(prep_list_id, store_id) > prep_lists.(id, store_id)

Ref: shift_assignments.(staff_id, store_id) > staff.(id, store_id)
Ref: shift_assignments.(shift_id, store_id) > shifts.(id, store_id)
Ref: punches.(staff_id, store_id)   > staff.(id, store_id)
Ref: contracts.(staff_id, store_id) > staff.(id, store_id)

// 품목 하나에 제외 표시 한 줄 — 1:1
Ref: cost_excluded_items.(item_id, store_id) - items.(id, store_id)
Ref: daily_checks.(step_id, store_id)        > steps.(id, store_id)
Ref: daily_checks.(prep_task_id, store_id)   > prep_tasks.(id, store_id)
Ref: daily_checks.(checked_by, store_id)     > staff.(id, store_id)

TableGroup "교육 · 체크리스트" {
  positions
  sections
  steps
}

TableGroup "프렙" {
  prep_lists
  prep_tasks
  prep_cycle_state
  daily_checks
}

TableGroup "근무 · 근태" {
  shifts
  shift_focus
  staff
  shift_assignments
  punches
  contracts
}

TableGroup "매장 설정" {
  store_settings
  cost_excluded_items
}
