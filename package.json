{
  "name": "store-note",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:replit": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "start:replit": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "check": "npm run typecheck && npm run build && npm test && npm run counts:db && npm run verify:db && npm run audit:db && npm run sweep:db && npm run dbml:db && npm run docs:db && npm run shootlist:check",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --watch",
    "test:cov": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage",
    "counts:db": "node db/counts.js",
    "verify:db": "node db/verify.js",
    "audit:db": "node db/audit.js",
    "sweep:db": "node db/sweep.js",
    "dbml:db": "node db/checkdbml.js",
    "docs:db": "node db/docs.js",
    "shootlist": "node db/shootlist.js",
    "shootlist:check": "node db/shootlist.js --check"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dbml/core": "^10.1.1",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
